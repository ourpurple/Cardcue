# ==============================================================================
# CardCue VPS 宿主机 Nginx 反向代理配置样例 (终结 HTTPS)
# 适用场景: VPS 宿主机已有 Nginx，反向代理请求到 Docker 容器 (127.0.0.1:3000)
#
# 使用方式:
# 1. 替换 cardcue.yourdomain.com 为您的实际域名
# 2. 确保证书文件路径正确 (如 Let's Encrypt Certbot 证书)
# 3. 复制到 /etc/nginx/conf.d/cardcue.conf 并执行 nginx -t && nginx -s reload
# ==============================================================================

# HTTP 80 端口自动重定向到 HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name cardcue.yourdomain.com;

    # 用于 ACME 证书校验 (Let's Encrypt)
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS 443 端口主服务
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cardcue.yourdomain.com;

    # SSL 证书文件配置 (以 Certbot 为例)
    ssl_certificate /etc/letsencrypt/live/cardcue.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cardcue.yourdomain.com/privkey.pem;

    # 现代 SSL 协议与强密码套件
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:CardCueSSL:10m;
    ssl_session_tickets off;

    # 企业级安全响应头 (防御 Clickjacking、MIME 混淆、跨站请求)
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # 上传与请求体大小限制 (适应邮件与大附件解析)
    client_max_body_size 30M;

    # Gzip 静态资源高效压缩
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # 反向代理到 Docker Compose 中的 web 容器 (映射在宿主机 127.0.0.1:3000)
    # web 容器内部的 Nginx 会自动处理:
    # 1. 前端 React SPA 静态资源路由回退 (try_files $uri /index.html)
    # 2. 自动内网反向代理 /v1/ API 到 FastAPI 容器 (http://api:8000/v1/)
    # 3. 自动反向代理 /health 健康检查到 FastAPI 容器
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # 保持真实的公网来源标头，用于 FastAPI 进行 CSRF 与 Origin 强校验
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # 超时设置 (防止大模型长耗时提取断开)
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}
