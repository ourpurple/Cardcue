# ==============================================================================
# CardCue 生产环境环境变量配置模板 (VPS Docker 部署)
# 复制本文件为 deploy/.env 并根据实际 VPS 域名与密钥进行修改:
# cp deploy/env.example deploy/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 权威数据库配置 (支持外部独立数据库或本地 Docker 容器)
# ------------------------------------------------------------------------------
# 模式 A: 使用外部已有系统的 PostgreSQL (例如 152.70.238.24):
DATABASE_URL=postgresql+asyncpg://cardcube:TPAdhfnyLmLptJxx@152.70.238.24:5432/cardcube
DATABASE_SYNC_URL=postgresql+psycopg2://cardcube:TPAdhfnyLmLptJxx@152.70.238.24:5432/cardcube

# 模式 B: 使用 docker-compose 自带本地 PostgreSQL (配合 --profile local-db):
# DATABASE_URL=postgresql+asyncpg://cardcube:changeme@db:5432/cardcube
# DATABASE_SYNC_URL=postgresql+psycopg2://cardcube:changeme@db:5432/cardcube

# ------------------------------------------------------------------------------
# 2. 系统运行环境与公网安全鉴权 (生产环境强防护)
# ------------------------------------------------------------------------------
# 设置为 production 时，系统会启用严格的公网安全校验:
# - 必须使用 HTTPS PUBLIC_ORIGIN
# - Cookie 强制启用 Secure + HttpOnly + SameSite=Lax
# - 校验 MAIL_ENCRYPTION_KEY 长度至少 32 字符 (AES-256 强密钥)
ENVIRONMENT=production

# 公网访问的 HTTPS 域名完整 URL (末尾不要带斜杠，必须为 https://)
# 宿主机反向代理 (Nginx/Caddy) 终结 SSL 后的公网入口
PUBLIC_ORIGIN=https://cardcue.yourdomain.com

# 管理员 Web 登录会话有效期 (小时)，默认 12 小时
SESSION_HOURS=12

# ------------------------------------------------------------------------------
# 3. 敏感数据加密主密钥 (AES-256-GCM)
# ------------------------------------------------------------------------------
# 用于在数据库中高强度对称加密存储邮箱授权码、大模型 API Key 等机密数据。
# 固定 32 字符的强随机字符串 (AES-256 标准)，严禁使用弱口令或默认示例值！
MAIL_ENCRYPTION_KEY=WoMCevRe4fkUW3yrrt4eCXR0cP1GOpF4

# 密钥版本 ID (默认 v1)
ENCRYPTION_KEY_ID=v1

# ------------------------------------------------------------------------------
# 4. 邮件持久化存储沙盒路径与轮询设置
# ------------------------------------------------------------------------------
# 邮件原始纯文本与受控附件在容器内的存储沙盒根目录 (已挂载 docker volume: mail_data)
MAIL_STORAGE_DIR=/app/data/mail_storage

# 定时检查新邮件的轮询间隔 (分钟)
MAIL_CHECK_INTERVAL_MINUTES=30

# 单邮件最大限制字节数 (默认 20MB = 20971520)
MAIL_MAX_BYTES=20971520

# 单次同步拉取最大邮件数 (默认 100)
MAIL_BATCH_LIMIT=100

# ------------------------------------------------------------------------------
# 5. 出站网络与 SSRF 防护白名单 (可选)
# ------------------------------------------------------------------------------
# 系统已内置对 RFC 1918 私网、127.0.0.1 回环与云厂商元数据 IP 的严格拦截。
# 如需在专用内网部署自定义 IMAP/LLM 代理，可在此配置允许的内网域名或主机名 (逗号分隔):
OUTBOUND_ALLOWED_HOSTS=

# ------------------------------------------------------------------------------
# 6. 大模型服务默认配置 (支持 HTTP/HTTPS 与自定义端口反代网关)
# ------------------------------------------------------------------------------
LLM_BASE_URL=http://23.169.184.101:8317/v1
LLM_MODEL=gemini-3.8-flash-high
LLM_API_KEY=sk-njh2603205
