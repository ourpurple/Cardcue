# ==============================================================================
# CardCue 生产环境环境变量配置模板 (VPS Docker 部署)
# 复制本文件为 deploy/.env 并根据实际 VPS 域名与密钥进行修改:
# cp deploy/env.example deploy/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 权威数据库配置
# ------------------------------------------------------------------------------
POSTGRES_USER=cardcue
POSTGRES_PASSWORD=replace_with_a_secure_random_db_password_here
POSTGRES_DB=cardcue

# 容器内应用使用的数据库连接串 (通过 Docker 内部网络 'db:5432' 互联)
DATABASE_URL=postgresql+asyncpg://cardcue:replace_with_a_secure_random_db_password_here@db:5432/cardcue
DATABASE_SYNC_URL=postgresql+psycopg2://cardcue:replace_with_a_secure_random_db_password_here@db:5432/cardcue

# ------------------------------------------------------------------------------
# 2. 系统运行环境与公网安全鉴权 (生产环境强防护)
# ------------------------------------------------------------------------------
# 设置为 production 时，系统会启用严格的公网安全校验:
# - 必须使用 HTTPS PUBLIC_ORIGIN
# - Cookie 强制启用 Secure + HttpOnly + SameSite=Lax
# - 校验 MAIL_ENCRYPTION_KEY 长度至少 40 字符
ENVIRONMENT=production

# 公网访问的 HTTPS 域名完整 URL (末尾不要带斜杠，必须为 https://)
# 宿主机反向代理 (Nginx/Caddy) 终结 SSL 后的公网入口
PUBLIC_ORIGIN=https://cardcue.yourdomain.com

# 管理员 Web 登录会话有效期 (小时)，默认 12 小时
SESSION_HOURS=12

# ------------------------------------------------------------------------------
# 3. 敏感数据加密主密钥 (AES-256-GCM)
# ------------------------------------------------------------------------------
# 用于在数据库中高强度对称加密存储邮箱授权码、大模型 API Key 等机密数据。
# 生产环境要求至少 40 个字符，严禁使用弱口令或默认示例值！
# 生成推荐命令: openssl rand -base64 36
MAIL_ENCRYPTION_KEY=replace_with_a_random_secret_key_at_least_40_chars_long_1234567890

# 密钥版本 ID (默认 v1)
ENCRYPTION_KEY_ID=v1

# ------------------------------------------------------------------------------
# 4. 邮件持久化存储沙盒路径与配额限制
# ------------------------------------------------------------------------------
# 邮件原始纯文本与受控附件在容器内的存储沙盒根目录 (已挂载 docker volume: mail_data)
MAIL_STORAGE_DIR=/app/data/mail_storage

# 单邮件最大限制字节数 (默认 20MB = 20971520)
MAIL_MAX_BYTES=20971520

# 单次同步拉取最大邮件数 (默认 100)
MAIL_BATCH_LIMIT=100

# ------------------------------------------------------------------------------
# 5. 出站网络与 SSRF 防护白名单 (可选)
# ------------------------------------------------------------------------------
# 系统已内置对 RFC 1918 私网、127.0.0.1 回环与云厂商元数据 IP 的严格拦截。
# 如需在专用内网部署自定义 IMAP/LLM 代理，可在此配置允许的内网域名或主机名 (逗号分隔):
OUTBOUND_ALLOWED_HOSTS=

# ------------------------------------------------------------------------------
# 6. 大模型服务默认配置 (可选，也可在 Web 管理端界面中动态配置)
# ------------------------------------------------------------------------------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
