# CardCue VPS 生产环境配置模板
# 复制本文件为 backend/.env 并修改对应字段

# 数据库异步连接与同步连接（Alembic 迁移使用同步连接）
# 若容器使用 host 网络或通过宿主机 IP 连接，填入实际 IP/主机名
DATABASE_URL=postgresql+asyncpg://cardcube:TPAdhfnyLmLptJxx@152.70.238.24:5432/cardcube
DATABASE_SYNC_URL=postgresql+psycopg2://cardcube:TPAdhfnyLmLptJxx@152.70.238.24:5432/cardcube

# 邮箱凭据对称加密密钥 (固定 32 字符的强随机字符串，请妥善保管)
MAIL_ENCRYPTION_KEY=cardcue-secret-key-32-bytes-long!

# 邮件正文与附件文件持久化路径 (Docker 内默认挂载至 /app/data/mail_storage)
MAIL_STORAGE_DIR=/app/data/mail_storage

# 定时检查新邮件的轮询间隔 (分钟)
MAIL_CHECK_INTERVAL_MINUTES=30

# ==============================================================================
# 大模型账单智能解析配置 (支持 DeepSeek, 阿里百炼/通义千问, 硅基流动, OpenAI 接口)
# 填入 API Key 即可全自动启用 AI 智能识别各种复杂银行表格、图片转文本与 PDF 账单
# 留空或不填则自动回退至规则/正则解析
# ==============================================================================
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 常用模型厂商参数参考：
# 1. DeepSeek:
#    LLM_API_KEY=sk-xxxxxxxx
#    LLM_BASE_URL=https://api.deepseek.com/v1
#    LLM_MODEL=deepseek-chat
#
# 2. 阿里云百炼 (通义千问 Qwen):
#    LLM_API_KEY=sk-xxxxxxxx
#    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#    LLM_MODEL=qwen-plus
#
# 3. 硅基流动 (SiliconFlow):
#    LLM_API_KEY=sk-xxxxxxxx
#    LLM_BASE_URL=https://api.siliconflow.cn/v1
#    LLM_MODEL=deepseek-ai/DeepSeek-V3
