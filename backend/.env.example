# CardCue backend environment – DO NOT commit real credentials.
# Copy to .env and fill in your values.
DATABASE_URL=postgresql+asyncpg://cardcube:CHANGE_ME@localhost:5432/cardcube
DATABASE_SYNC_URL=postgresql+psycopg2://cardcube:CHANGE_ME@localhost:5432/cardcube

# 邮箱凭据对称加密密钥 (固定 32 字符的强随机字符串)
MAIL_ENCRYPTION_KEY=cardcue-secret-key-32-bytes-long!

# 邮件正文与附件文件持久化路径
MAIL_STORAGE_DIR=data/mail_storage

# 定时检查新邮件的轮询间隔 (分钟)
MAIL_CHECK_INTERVAL_MINUTES=30

# ==============================================================================
# 大模型账单解析配置 (支持任意兼容 OpenAI 标准接口的模型厂商)
# 留空 LLM_API_KEY 则自动降级为本地规则/正则解析引擎
# ==============================================================================
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 常用模型厂商配置参考：
# 1. DeepSeek (推荐，性价比与提取精度极高):
