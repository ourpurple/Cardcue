[Unit]
Description=CardCue Mail Background Scheduler
After=network.target cardcue-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cardcue/backend
EnvironmentFile=/opt/cardcue/backend/.env
ExecStart=/opt/cardcue/backend/.venv/bin/python -m cardcue_api.jobs.scheduler
Restart=always
RestartSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
